[Unit]
Description=DentalKnowledgeBase anatomy and contribution preview
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/srv/dental-preview
BindReadOnlyPaths=/root/projeler/DentalKnowledgeBase/apps/preview:/srv/dental-preview/apps/preview
BindReadOnlyPaths=/root/projeler/DentalKnowledgeBase/packages/domain:/srv/dental-preview/packages/domain
BindReadOnlyPaths=/root/projeler/DentalKnowledgeBase/packages/rights:/srv/dental-preview/packages/rights
ExecStart=/usr/bin/node /srv/dental-preview/apps/preview/server.mjs
Environment=PREVIEW_PORT=3057
Environment=PREVIEW_HOST=192.168.1.192
Environment=PREVIEW_ORIGIN=http://192.168.1.192:3057
Environment=CONTRIBUTIONS_DIR=/var/lib/dental-preview/contributions
StateDirectory=dental-preview
StateDirectoryMode=0700
LoadCredential=moderator.key:/etc/dental-preview/moderator.key
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
