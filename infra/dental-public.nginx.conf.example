# Replace dental.example.org and certificate paths before installing.
# Include in nginx http context. Not installed automatically.
server {
    listen 80;
    server_name dental.example.org;
    return 308 https://dental.example.org$request_uri;
}
server {
    listen 443 ssl;
    server_name dental.example.org;
    ssl_certificate /etc/letsencrypt/live/dental.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dental.example.org/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 24k;
    client_body_timeout 15s;

    # Private contribution IDs and user input must not enter access logs.
    location /api/contributions {
        access_log off;
        proxy_pass http://127.0.0.1:3057;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-Proto "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
    location / {
        proxy_pass http://127.0.0.1:3057;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-Proto "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
}
