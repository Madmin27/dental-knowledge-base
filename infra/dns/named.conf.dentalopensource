include "/etc/bind/keys/dentalopensource-acme.key";
zone "dentalopensource.org" {
    type master;
    file "/var/lib/bind/dentalopensource/db.dentalopensource.org";
    allow-query { any; };
    allow-transfer { none; };
    update-policy {
        grant dentalopensource-acme name _acme-challenge.dentalopensource.org. TXT;
    };
    notify no;
};
